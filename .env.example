# Application
APP_NAME=Open-Source Project Radar
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# MongoDB Atlas (required) — replace with your cluster URI; never commit real credentials
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/project_radar?retryWrites=true&w=majority
MONGODB_DB_NAME=project_radar

# Auth
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=

# GitHub (never expose to frontend)
GITHUB_TOKEN=

# Discovery
DISCOVERY_LANGUAGES=Python,TypeScript,JavaScript,Go,Rust
DISCOVERY_TOPICS=ai,llm,agent,devtools,framework
DISCOVERY_MIN_STARS=10
DISCOVERY_CREATED_WITHIN_DAYS=90
GITHUB_MAX_PAGES=2

# Scheduler
ENABLE_SCHEDULER=true
SNAPSHOT_INTERVAL_MINUTES=45
DISCOVERY_INTERVAL_MINUTES=60
SCORING_INTERVAL_MINUTES=30
ALERT_INTERVAL_MINUTES=15

# AI via TokenRouter (OpenAI-compatible). Paste your key into OPENAI_API_KEY.
OPENAI_API_BASE=https://api.tokenrouter.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=z-ai/glm-4-9b-chat
OPENAI_FALLBACK_MODEL=nvidia/nemotron-3-8b-instruct:free
AI_ENABLED=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
